# ============================================================
# Personal AI Agent Assistant — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file to version control!
# ============================================================

# ------------------------------------------------------------
# LLM Provider Settings
# ------------------------------------------------------------
# Choose your LLM provider: gemini | openai | anthropic | ollama
LLM_PROVIDER=ollama

# Your API key for the chosen provider
# Not required for Ollama — it runs fully locally!
# Gemini:    https://aistudio.google.com/app/apikey
# OpenAI:    https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/settings/keys
API_KEY=

# Specific model to use
# Must be already pulled via: ollama pull llama3.2
# Other good local models: mistral, phi3, gemma2, codellama
LLM_MODEL=llama3.2

# Ollama base URL (only needed if using Ollama provider)
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------
# Agent Preferences
# ------------------------------------------------------------
# Name for your AI assistant
AGENT_NAME=Jarvis

# If true, the agent will ask for confirmation before any
# destructive action (file deletion, running shell commands, etc.)
SAFE_MODE=true

# Maximum reasoning iterations per task (prevents infinite loops)
MAX_ITERATIONS=10

# ------------------------------------------------------------
# Storage & Workspace
# ------------------------------------------------------------
# Directory the agent is allowed to read/write files in
# Defaults to ~/assistant-workspace if not set
WORKSPACE_DIR=

# Directory for agent logs and session history
LOG_DIR=~/.assistant/logs

# ------------------------------------------------------------
# Web UI (Sprint 5)
# ------------------------------------------------------------
# Port for the web dashboard server
UI_PORT=8000
